<?xml version="1.0" encoding="utf-8" ?>
<!-- Una categoría como pastilla (fila de categorías arriba de En vivo, Películas y Series). -->
<component name="ChipItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="paint" />
    <field id="focusPercent" type="float" onChange="paint" />
    <field id="rowListHasFocus" type="boolean" onChange="paint" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/items/ChipItem.brs" />
  <children>
    <Poster id="bg" uri="pkg:/images/chip_glass.9.png" width="160" height="30" />
    <Poster id="ring" uri="pkg:/images/chip_focus.9.png" width="160" height="30" visible="false" />
    <Label id="name" width="148" height="30" translation="[6,0]" horizAlign="center" vertAlign="center" color="0xCDB8C9FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="12" />
    </Label>
  </children>
</component>
