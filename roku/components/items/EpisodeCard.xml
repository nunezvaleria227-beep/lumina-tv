<?xml version="1.0" encoding="utf-8" ?>
<!-- Episodio de una serie: imagen apaisada, "E1", progreso y el nombre debajo. -->
<component name="EpisodeCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="paint" />
    <field id="rowListHasFocus" type="boolean" onChange="paint" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/items/EpisodeCard.brs" />
  <children>
    <Poster id="bg" uri="pkg:/images/card_bg.9.png" width="212" height="119" />
    <MaskGroup maskUri="pkg:/images/card_mask.png" maskSize="[212,119]">
      <Poster id="art" width="212" height="119" loadDisplayMode="scaleToZoom" loadWidth="424" loadHeight="238" />
    </MaskGroup>
    <Poster uri="pkg:/images/badge_dark.9.png" translation="[8,8]" width="34" height="20" />
    <Label id="num" translation="[8,8]" width="34" height="20" horizAlign="center" vertAlign="center" color="0xFFFFFFFF">
      <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="11" />
    </Label>
    <Poster id="watchBox" uri="pkg:/images/badge_pink.9.png" translation="[148,8]" width="56" height="20" visible="false" />
    <Label id="watch" translation="[148,8]" width="56" height="20" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" text="VIENDO" visible="false">
      <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="10" />
    </Label>
    <Rectangle id="barBg" translation="[0,115]" width="212" height="4" color="0xFFFFFF55" visible="false" />
    <Rectangle id="bar" translation="[0,115]" width="0" height="4" color="0xF2268AFF" visible="false" />
    <Poster id="ring" uri="pkg:/images/ring_white.9.png" translation="[-4,-4]" width="220" height="127" visible="false" />
    <Label id="title" translation="[0,126]" width="212" height="22" color="0xFBF3F9FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="13" />
    </Label>
    <Label id="subLabel" translation="[0,148]" width="212" height="18" color="0x9F8A9CFF">
      <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="11" />
    </Label>
  </children>
</component>
