<?xml version="1.0" encoding="utf-8" ?>
<!-- Un canal en la lista de En vivo: número, logo y nombre. -->
<component name="ChannelRow" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="index" type="integer" onChange="onContent" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/items/ChannelRow.brs" />
  <children>
    <Poster id="card" uri="pkg:/images/list_row.9.png" width="560" height="52" />
    <Label id="num" translation="[6,0]" width="40" height="52" horizAlign="right" vertAlign="center" color="0x9F8A9CFF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="12" />
    </Label>
    <Poster id="logoBox" uri="pkg:/images/card_bg.9.png" translation="[56,6]" width="40" height="40" />
    <Poster id="logo" translation="[58,8]" width="36" height="36" loadDisplayMode="scaleToFit" loadWidth="72" loadHeight="72" />
    <Label id="name" translation="[108,0]" width="400" height="52" vertAlign="center" color="0xFBF3F9FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="15" />
    </Label>
    <Poster id="fav" uri="pkg:/images/star4.png" translation="[526,18]" width="16" height="16" visible="false" />
  </children>
</component>
