<?xml version="1.0" encoding="utf-8" ?>
<!-- Entrar a Lumina TV (diseño "Neón"): logo grande arriba con brillo rosa y, al centro, usuario, contraseña y Entrar. -->
<component name="LoginScreen" extends="Group">
  <interface>
    <field id="event" type="assocarray" alwaysNotify="true" />
    <function name="focusScreen" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/screens/LoginScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <children>
    <Poster id="bg" uri="pkg:/images/login_bg.jpg" width="1280" height="720" />

    <Label text="USUARIO" translation="[431,210]" width="300" height="18" color="0xA88FA4FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="11" />
    </Label>
    <Poster id="userBox" uri="pkg:/images/field.9.png" translation="[427,230]" width="426" height="54" />
    <Poster id="userIcon" uri="pkg:/images/ic_user.png" translation="[446,247]" width="20" height="20" blendColor="0xCDB8C9FF" />
    <Label id="userText" translation="[478,230]" width="360" height="54" vertAlign="center" color="0xFBF3F9FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="17" />
    </Label>

    <Label text="CONTRASEÑA" translation="[431,298]" width="300" height="18" color="0xA88FA4FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="11" />
    </Label>
    <Poster id="passBox" uri="pkg:/images/field.9.png" translation="[427,318]" width="426" height="54" />
    <Poster id="passIcon" uri="pkg:/images/ic_lock.png" translation="[446,335]" width="20" height="20" blendColor="0xCDB8C9FF" />
    <Label id="passText" translation="[478,318]" width="360" height="54" vertAlign="center" color="0xFBF3F9FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="17" />
    </Label>

    <Poster id="btn" uri="pkg:/images/btn_enter.png" translation="[427,400]" width="426" height="56" />
    <Label id="btnText" translation="[427,400]" width="426" height="56" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" text="Entrar">
      <Font role="font" uri="pkg:/fonts/Poppins-Bold.ttf" size="19" />
    </Label>
    <Poster id="btnArrow" uri="pkg:/images/ic_arrow.png" translation="[676,418]" width="20" height="20" />

    <Label id="error" translation="[377,464]" width="526" height="44" wrap="true" horizAlign="center" color="0xFF6B7AFF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="13" />
    </Label>
    <Label id="status" translation="[377,464]" width="526" height="24" horizAlign="center" color="0xCDB8C9FF">
      <Font role="font" uri="pkg:/fonts/Poppins-Medium.ttf" size="14" />
    </Label>
    <Group id="devices" translation="[0,516]" />
    <Label id="lastTry" translation="[290,650]" width="700" height="44" wrap="true" horizAlign="center" color="0x6E5A6BFF">
      <Font role="font" uri="pkg:/fonts/Poppins-Regular.ttf" size="11" />
    </Label>
    <Timer id="autoTimer" duration="0.1" repeat="false" />
  </children>
</component>
